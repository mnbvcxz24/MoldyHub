local GameLinks = {
    [95168737547508] = "https://raw.githubusercontent.com/mnbvcxz24/MoldyHub/main/Games/SAPARI.lua",
    [114326934417838] = "https://raw.githubusercontent.com/mnbvcxz24/MoldyHub/refs/heads/main/Games/BASAE.lua"
}

local url = GameLinks[game.PlaceId]

if not url then
    warn("[MoldyHub] Unsupported Game PlaceId: " .. tostring(game.PlaceId))
    return
end

local source = game:HttpGet(url)

local fn, err = loadstring(source)
if not fn then
    warn("[MoldyHub] Failed to load source: " .. tostring(err))
    return
end

fn()
